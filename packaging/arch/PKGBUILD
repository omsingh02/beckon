# Maintainer: omsingh02 (https://github.com/omsingh02)
#
# Beckon for Arch Linux, from the release tarball. Build and install it from a clone of the repository:
#
#     cd packaging/arch && makepkg -si
#
# It can be published to the AUR as `beckon-bin` too. scripts/update-package-manifests.sh <tag> fills in pkgver and
# the checksum from a release (the release script runs it).
pkgname=beckon-bin
_tag=v2.0.0-alpha.4
pkgver=2.0.0_alpha.4
pkgrel=1
pkgdesc="Use your Android phone as a trackpad, keyboard and media remote for this computer"
arch=('x86_64')
url="https://github.com/omsingh02/beckon"
license=('MIT')
depends=('gcc-libs' 'glibc' 'libxcb')
optdepends=('gnome-shell-extension-appindicator: the tray icon on GNOME')
provides=('beckon')
conflicts=('beckon')
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/${_tag}/beckon-${_tag}-linux-x86_64.tar.gz")
sha256sums=('050774f29de32db63d92c8841ee8701a7ab1ea30153b9788f79658c8661ee916')

package() {
  cd "beckon-${_tag}-linux-x86_64"

  install -Dm755 beckon "$pkgdir/usr/bin/beckon"
  install -Dm644 beckon.desktop "$pkgdir/usr/share/applications/beckon.desktop"
  install -Dm644 beckon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/beckon.svg"
  for size in 16 24 32 48 64 128 256 512; do
    install -Dm644 "icons/beckon-$size.png" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/beckon.png"
  done

  # The virtual keyboard and mouse: the kernel module at boot, and access for whoever is at the seat.
  install -Dm644 60-beckon-uinput.rules "$pkgdir/usr/lib/udev/rules.d/60-beckon-uinput.rules"
  echo uinput | install -Dm644 /dev/stdin "$pkgdir/usr/lib/modules-load.d/beckon.conf"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD_PARTY_LICENSES.md "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_LICENSES.md"
}
